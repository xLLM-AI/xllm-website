---
import Layout from '~/layouts/PageLayout.astro';
import { frontmatter as supportedModelsData } from '~/data/supported-models.md';

const metadata = {
  title: 'Supported Models',
};

type SupportedModelItem = {
  name: string;
  support: string[];
};

type SupportedModelGroup = {
  id: string;
  title: string;
  intro: string;
  items: SupportedModelItem[];
};

const supportedModelGroups = supportedModelsData.supportedModelGroups as SupportedModelGroup[];
---

<Layout metadata={metadata}>
  <section class="not-prose">
    <div class="mx-auto max-w-7xl px-4 py-12 md:px-6 md:py-16">
      <div class="scroll-fade mx-auto max-w-4xl text-center">
        <h1 class="mt-3 text-3xl font-bold tracking-tight text-heading md:text-4xl dark:text-white">
          Mainstream Models Supported by xLLM
        </h1>
      </div>
      <div class="mx-auto mt-10 max-w-6xl space-y-6">
        {
          supportedModelGroups.map((group) => (
            <section
              id={group.id}
              class="scroll-fade card-hover rounded-[2rem] border border-slate-200/80 bg-white/75 p-6 dark:border-slate-700 dark:bg-slate-900/50"
            >
              <div class="max-w-3xl">
                <h2 class="text-2xl font-semibold text-heading dark:text-white">{group.title}</h2>
              </div>

              <div class="mt-6 overflow-x-auto">
                <table class="w-full min-w-[640px] border-separate border-spacing-0">
                  <thead>
                    <tr>
                      <th class="rounded-l-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-left text-sm font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
                        Model
                      </th>
                      <th class="border-y border-slate-200 bg-slate-50 px-4 py-3 text-left text-sm font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
                        NPU
                      </th>
                      <th class="border-y border-slate-200 bg-slate-50 px-4 py-3 text-left text-sm font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
                        MLU
                      </th>
                      <th class="rounded-r-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-left text-sm font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
                        ILU
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {group.items.map((item: SupportedModelItem) => (
                      <tr>
                        <td class="border-b border-slate-200 px-4 py-3 text-sm text-slate-800 dark:border-slate-700 dark:text-slate-200">
                          {item.name}
                        </td>
                        <td class="border-b border-slate-200 px-4 py-3 text-sm dark:border-slate-700">
                          {item.support.includes('NPU') ? '✅' : '—'}
                        </td>
                        <td class="border-b border-slate-200 px-4 py-3 text-sm dark:border-slate-700">
                          {item.support.includes('MLU') ? '✅' : '—'}
                        </td>
                        <td class="border-b border-slate-200 px-4 py-3 text-sm dark:border-slate-700">
                          {item.support.includes('ILU') ? '✅' : '—'}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
