---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';

const metadata = {
  title: 'xLLM',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <section class="relative md:-mt-[76px] not-prose">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(220,38,38,0.16),transparent_50%),radial-gradient(circle_at_80%_22%,rgba(220,38,38,0.16),transparent_52%),linear-gradient(to_bottom,#fff,rgba(248,250,252,0.92))] dark:bg-[radial-gradient(circle_at_top,rgba(220,38,38,0.18),transparent_50%),radial-gradient(circle_at_80%_22%,rgba(220,38,38,0.18),transparent_52%),linear-gradient(to_bottom,#020617,#0f172a)]"
      >
      </div>
    </div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
      <div class="pointer-events-none pt-0 md:pt-[76px]"></div>
      <div class="py-12 md:py-16">
        <div class="mx-auto max-w-4xl text-center">
          <img src="/images/logo.png" alt="xLLM logo" class="mx-auto h-28 w-auto" />
          <h1 class="mt-3 text-3xl font-bold leading-tight tracking-tight text-heading md:text-3xl dark:text-white">
            The <span class="font-extrabold text-[#e60000]">High-Performance</span> Inference Framework for
            <span class="font-extrabold text-[#e60000]">LLM, VLM, DiT and REC</span> Models on Heterogeneous Accelerators
          </h1>
          <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <Button
              variant="primary"
              text="Get Started"
              href="https://xllm.readthedocs.io/zh-cn/latest/getting_started/quick_start/"
              target="_blank"
              icon="tabler:book-2"
              class="border-[#c84a16] bg-[#c84a16] text-white hover:border-[#a93a0f] hover:bg-[#a93a0f] dark:border-[#c84a16] dark:bg-[#c84a16] dark:hover:border-[#a93a0f] dark:hover:bg-[#a93a0f]"
            />
          </div>
        </div>

        <div class="mx-auto mt-12 grid max-w-6xl gap-4 md:grid-cols-3">
          <div
            class="card-hover rounded-3xl border border-slate-200/80 bg-white/75 p-6 dark:border-slate-700 dark:bg-slate-900/50"
          >
            <h2 class="flex items-center gap-2 text-xl font-semibold text-heading dark:text-white">
              <Icon name="tabler:circle-check" class="h-5 w-5 text-[rgba(220,38,38,0.75)]" />
              Easy
            </h2>
            <p class="mt-3 text-sm text-muted md:text-base">
              Deploy mainstream open models on supported accelerators with a unified service-engine stack and
              production-oriented tooling.
            </p>
          </div>
          <div
            class="card-hover rounded-3xl border border-slate-200/80 bg-white/75 p-6 dark:border-slate-700 dark:bg-slate-900/50"
          >
            <h2 class="flex items-center gap-2 text-xl font-semibold text-heading dark:text-white">
              <Icon name="tabler:bolt" class="h-5 w-5 text-[rgba(220,38,38,0.75)]" />
              Fast
            </h2>
            <p class="mt-3 text-sm text-muted md:text-base">
              Improve throughput with asynchronous scheduling, graph optimization, multi-stream execution, and dynamic
              load balancing.
            </p>
          </div>
          <div
            class="card-hover rounded-3xl border border-slate-200/80 bg-white/75 p-6 dark:border-slate-700 dark:bg-slate-900/50"
          >
            <h2 class="flex items-center gap-2 text-xl font-semibold text-heading dark:text-white">
              <Icon name="tabler:coins" class="h-5 w-5 text-[rgba(220,38,38,0.75)]" />
              Cost Efficient
            </h2>
            <p class="mt-3 text-sm text-muted md:text-base">
              Reduce inference cost through hardware-aware optimization, efficient memory management, and global KV
              cache control.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="community" class="not-prose">
    <div class="mx-auto max-w-7xl px-4 py-10 md:px-6 md:py-12 lg:py-16">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-wide text-[rgba(220,38,38,0.75)]">Got Questions?</p>
        <h2 class="mt-3 text-2xl font-bold tracking-tight text-heading md:text-3xl dark:text-white">
          We are here to help
        </h2>
        <p class="mt-3 text-base text-muted md:text-lg">
          Whether you are getting started or debugging a deployment, the public project resources are the fastest place
          to continue.
        </p>
      </div>

      <div class="mx-auto mt-8 grid max-w-6xl gap-4 md:grid-cols-3">
        <a
          href="https://xllm.readthedocs.io/zh-cn/latest/"
          target="_blank"
          rel="noopener noreferrer"
          class="card-hover rounded-3xl border border-slate-200/80 bg-white/75 p-6 hover:border-slate-300 hover:bg-white dark:border-slate-700 dark:bg-slate-900/50 dark:hover:border-slate-600"
        >
          <h3 class="flex items-center gap-2 text-lg font-semibold text-heading dark:text-white">
            <Icon name="tabler:book-2" class="h-5 w-5 text-[rgba(220,38,38,0.75)]" />
            Documentation
          </h3>
          <p class="mt-3 text-sm text-muted md:text-base">
            Setup guides, features, launch flows, and reference material.
          </p>
        </a>
        <a
          href="https://github.com/jd-opensource/xllm/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="card-hover rounded-3xl border border-slate-200/80 bg-white/75 p-6 hover:border-slate-300 hover:bg-white dark:border-slate-700 dark:bg-slate-900/50 dark:hover:border-slate-600"
        >
          <h3 class="flex items-center gap-2 text-lg font-semibold text-heading dark:text-white">
            <Icon name="tabler:message-circle" class="h-5 w-5 text-[rgba(220,38,38,0.75)]" />
            GitHub Issues
          </h3>
          <p class="mt-3 text-sm text-muted md:text-base">
            Bug reports, feature requests, and implementation questions.
          </p>
        </a>
        <a
          href="https://github.com/jd-opensource/xllm/graphs/contributors"
          target="_blank"
          rel="noopener noreferrer"
          class="card-hover rounded-3xl border border-slate-200/80 bg-white/75 p-6 hover:border-slate-300 hover:bg-white dark:border-slate-700 dark:bg-slate-900/50 dark:hover:border-slate-600"
        >
          <h3 class="flex items-center gap-2 text-lg font-semibold text-heading dark:text-white">
            <Icon name="tabler:users" class="h-5 w-5 text-[rgba(220,38,38,0.75)]" />
            Contributors
          </h3>
          <p class="mt-3 text-sm text-muted md:text-base">
            See the developers and maintainers contributing to the project.
          </p>
        </a>
      </div>
    </div>
  </section>

  <section id="resources" class="not-prose">
    <div class="mx-auto max-w-7xl px-4 py-10 md:px-6 md:py-12 lg:py-16">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-wide text-[rgba(220,38,38,0.75)]">Resources</p>
        <h2 class="mt-3 text-2xl font-bold tracking-tight text-heading md:text-3xl dark:text-white">
          Explore docs, paper, and releases
        </h2>
        <p class="mt-3 text-base text-muted md:text-lg">Core project resources in one place.</p>
      </div>

      <div class="mx-auto mt-8 grid max-w-6xl gap-4 md:grid-cols-3">
        <a
          href="https://xllm.readthedocs.io/zh-cn/latest/"
          target="_blank"
          rel="noopener noreferrer"
          class="card-hover rounded-3xl border border-slate-200/80 bg-white/75 p-6 hover:border-slate-300 hover:bg-white dark:border-slate-700 dark:bg-slate-900/50 dark:hover:border-slate-600"
        >
          <h3 class="flex items-center gap-2 text-lg font-semibold text-heading dark:text-white">
            <Icon name="tabler:book-2" class="h-5 w-5 text-[rgba(220,38,38,0.75)]" />
            Documentation
          </h3>
          <p class="mt-3 text-sm text-muted md:text-base">Guides, setup instructions, and feature docs.</p>
        </a>
        <a
          href="https://arxiv.org/abs/2510.14686"
          target="_blank"
          rel="noopener noreferrer"
          class="card-hover rounded-3xl border border-slate-200/80 bg-white/75 p-6 hover:border-slate-300 hover:bg-white dark:border-slate-700 dark:bg-slate-900/50 dark:hover:border-slate-600"
        >
          <h3 class="flex items-center gap-2 text-lg font-semibold text-heading dark:text-white">
            <Icon name="tabler:file-text" class="h-5 w-5 text-[rgba(220,38,38,0.75)]" />
            Technical Report
          </h3>
          <p class="mt-3 text-sm text-muted md:text-base">Read the design and implementation overview on arXiv.</p>
        </a>
        <a
          href="https://quay.io/repository/jd_xllm/xllm-ai?tab=tags"
          target="_blank"
          rel="noopener noreferrer"
          class="card-hover rounded-3xl border border-slate-200/80 bg-white/75 p-6 hover:border-slate-300 hover:bg-white dark:border-slate-700 dark:bg-slate-900/50 dark:hover:border-slate-600"
        >
          <h3 class="flex items-center gap-2 text-lg font-semibold text-heading dark:text-white">
            <Icon name="tabler:brand-docker" class="h-5 w-5 text-[rgba(220,38,38,0.75)]" />
            Docker
          </h3>
          <p class="mt-3 text-sm text-muted md:text-base">
            Use published images as a starting point for deployment and development.
          </p>
        </a>
      </div>
    </div>
  </section>
</Layout>
