---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import PageHeader from '~/components/widgets/PageHeader.astro';
import type { Post } from '~/types';
import type { Locale } from '~/utils/i18n';
import { getLocalizedPathname } from '~/utils/i18n';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  post: Post;
  locale?: Locale;
}

const { post, locale = 'en' } = Astro.props;
const Content = post.Content;
const metadata = { title: post.title, description: post.excerpt, ...post.metadata };
const date = new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-US', {
  dateStyle: 'long',
  timeZone: 'UTC',
}).format(post.publishDate);
---

<Layout metadata={metadata} locale={locale}>
  <article>
    <PageHeader
      eyebrow={post.type === 'news' ? (locale === 'zh' ? '项目动态' : 'News') : locale === 'zh' ? '技术博客' : 'Blog'}
      title={post.title}
      description={post.excerpt}
      icon="tabler:article"
    >
      <div class="scroll-fade mt-6 flex max-w-3xl flex-wrap gap-x-4 gap-y-2 text-sm text-muted">
        {post.author && <span>{post.author}</span>}
        <time datetime={post.publishDate.toISOString()}>{date}</time>
      </div>
    </PageHeader>
    <div class="mx-auto max-w-7xl px-4 py-12 md:px-6 md:py-16">
      <div class="mx-auto max-w-3xl">
        <a
          href={getPermalink(getLocalizedPathname('/blog', locale))}
          class="inline-flex items-center gap-2 rounded text-sm font-medium text-muted hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
        >
          <Icon name="tabler:arrow-left" class="h-4 w-4" />
          {locale === 'zh' ? '返回博客' : 'Back to Blog'}
        </a>
        {
          post.image && (
            <Image
              src={post.image}
              alt=""
              width={1200}
              height={675}
              widths={[640, 960, 1200]}
              sizes="(max-width: 767px) 100vw, 768px"
              class="mt-8 h-auto w-full rounded-2xl"
              loading="eager"
            />
          )
        }
        <div
          class="prose mt-8 max-w-none break-words prose-headings:scroll-mt-24 prose-headings:font-semibold prose-headings:tracking-tight prose-a:text-accent prose-img:rounded-2xl dark:prose-invert"
        >
          {Content && <Content />}
        </div>
      </div>
    </div>
  </article>
</Layout>
