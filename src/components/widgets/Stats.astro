---
import type { Stats as Props } from '~/types';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { Icon } from 'astro-icon/components';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  stats = [],

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />
  <div class="flex flex-wrap justify-center -m-3 text-center">
    {
      stats &&
        stats.map(({ amount, title, icon }) => (
          <div class="p-3 md:w-1/4 sm:w-1/2 w-full min-w-[220px] text-center intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade intersect-quarter">
            <div class="card-hover h-full rounded-3xl border border-slate-200/80 dark:border-slate-700 bg-white/70 dark:bg-slate-900/50 px-4 py-5">
              {icon && (
                <div class="flex items-center justify-center mx-auto mb-3 text-primary">
                  <Icon name={icon} class="w-8 h-8" />
                </div>
              )}
              {amount && (
                <div class="font-heading text-primary text-2xl md:text-3xl font-bold dark:text-white">{amount}</div>
              )}
              {title && (
                <div class="mt-1 text-[11px] md:text-xs font-medium uppercase tracking-[0.18em] text-gray-800 dark:text-slate-400">
                  {title}
                </div>
              )}
            </div>
          </div>
        ))
    }
  </div>
</WidgetWrapper>
